{
    "name": "deepakkr/wp-cli-command-testing",
    "description": "Example WP-CLI commands with a full PHPUnit + Behat test setup, built to accompany a blog post on testing WP-CLI commands.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "wp-cli/wp-cli": "^2.11",
        "wp-cli/wp-cli-tests": "^4.2",
        "wp-cli/entity-command": "^2.6",
        "wp-phpunit/wp-phpunit": "^6.7",
        "yoast/phpunit-polyfills": "^2.0",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress": "^6.7",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "WPCLITesting\\": "src/"
        },
        "files": [
            "plugin.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WPCLITesting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "prepare-tests": "php bin/prepare-db.php",
        "behat": "bash -c 'set -a; [ -f .env ] && . .env; set +a; [ \"${WP_VERSION:-}\" = latest ] && unset WP_VERSION; vendor/bin/behat'",
        "behat:rerun": "bash -c 'set -a; [ -f .env ] && . .env; set +a; [ \"${WP_VERSION:-}\" = latest ] && unset WP_VERSION; vendor/bin/behat --rerun'",
        "behat:clean": "bash -c 'rm -rf \"${TMPDIR:-/tmp/}\"wp-cli-test-* /var/tmp/wp-cli-test-*; echo \"Behat caches cleared.\"'"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    }
}
