{
    "name": "deepakkr/wp-cli-command-testing",
    "description": "Example WP-CLI commands with a full PHPUnit + Behat test setup, built to accompany a blog post on testing WP-CLI commands.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "wp-cli/wp-cli": "^2.11",
        "wp-cli/wp-cli-tests": "^4.2",
        "wp-cli/entity-command": "^2.6",
        "wp-phpunit/wp-phpunit": "^6.7",
        "yoast/phpunit-polyfills": "^2.0",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress": "^6.7"
    },
    "autoload": {
        "psr-4": {
            "WPCLITesting\\": "src/"
        },
        "files": [
            "plugin.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WPCLITesting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "prepare-tests": "install-package-tests",
        "behat": "run-behat-tests",
        "behat:rerun": "rerun-behat-tests"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    }
}
