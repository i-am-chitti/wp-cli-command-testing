# Copy this to .env and adjust for your machine. .env is gitignored —
# it's local dev config. CI doesn't read it; the workflow sets these as
# real environment variables on the job instead.

# PHPUnit needs a real MySQL/MariaDB server (WordPress's test suite does).
WP_CLI_TEST_DBHOST=127.0.0.1:3308
WP_CLI_TEST_DBUSER=root
WP_CLI_TEST_DBPASS=root
WP_CLI_TEST_DBNAME=wp_cli_test
WP_CLI_TEST_DBROOTUSER=root
WP_CLI_TEST_DBROOTPASS=root

# Behat runs on SQLite locally, so it needs no database server and no mysql
# client at all. CI leaves this unset and runs Behat against MySQL instead.
WP_CLI_TEST_DBTYPE=sqlite

# Pin the WordPress version Behat installs, so it doesn't query wordpress.org
# on every run.
WP_VERSION=7.1

# WordPress 7.x archives need more than PHP CLI default 128M to extract.
WP_CLI_PHP_ARGS="-d memory_limit=512M"
